@echo off
set "COB_MAIN_DIR=C:\GnuCOBOL\"
set "PATH=%COB_MAIN_DIR%bin;%PATH%"
set "COB_CONFIG_DIR=%COB_MAIN_DIR%config"
set "COB_COPY_DIR=%COB_MAIN_DIR%copy"
echo Building CHIP-8 Core...
cobc -free -x -Wall -Icopybooks src\chip8_core.cbl -o chip8_core.exe
echo Building CHIP-8 Test...
cobc -free -x -Wall -Icopybooks tests\chip8_test.cbl -o chip8_test.exe
echo Building Disassembler Test...
cobc -free -x -Wall -Icopybooks tests\chip8_disasm_test.cbl src\chip8_disassembler.cbl -o chip8_disasm_test.exe
echo Building Super-CHIP Test...
cobc -free -x -Wall -Icopybooks tests\chip8_schip_test.cbl src\chip8_schip_ext.cbl -o chip8_schip_test.exe
echo Building Debugger Test...
cobc -free -x -Wall -Icopybooks tests\chip8_debug_test.cbl src\chip8_debugger.cbl -o chip8_debug_test.exe
echo Building Assembler Test...
cobc -free -x -Wall -Icopybooks tests\chip8_asm_test.cbl src\chip8_assembler.cbl -o chip8_asm_test.exe
echo Building ROM Loader Test...
cobc -free -x -Wall -Icopybooks tests\chip8_loader_test.cbl src\chip8_rom_loader.cbl -o chip8_loader_test.exe
echo Building Keypad Test...
cobc -free -x -Wall -Icopybooks tests\chip8_keypad_test.cbl src\chip8_keypad.cbl -o chip8_keypad_test.exe
echo Building Profiler Test...
cobc -free -x -Wall -Icopybooks tests\chip8_profiler_test.cbl src\chip8_profiler.cbl -o chip8_profiler_test.exe
echo Building Synth Test...
cobc -free -x -Wall -Icopybooks tests\chip8_synth_test.cbl src\chip8_audio_synth.cbl -o chip8_synth_test.exe
echo Building Rewind Test...
cobc -free -x -Wall -Icopybooks tests\chip8_rewind_test.cbl src\chip8_rewind_engine.cbl -o chip8_rewind_test.exe
